# ---------------------------------------------------------------------------
# Waitless — environment template
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:4000/api/v1
LOG_LEVEL=debug

# --- Datastores -------------------------------------------------------------
DATABASE_URL=postgresql://waitless:waitless@localhost:5432/waitless?schema=public
TEST_DATABASE_URL=postgresql://waitless:waitless@localhost:5432/waitless_test?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
QR_SIGNING_SECRET=dev-qr-secret-change-me

SEED_ADMIN_NAME=Hospital Admin
SEED_ADMIN_EMAIL=admin@waitless.local
SEED_ADMIN_PHONE=9000000000
SEED_ADMIN_PASSWORD=Admin@12345

# --- Queue rules ------------------------------------------------------------
GRACE_MINUTES=10
DELAY_MINUTES=10
AUTO_SKIP_ENABLED=true
SKIP_POLICY=end
SWAP_CUTOFF_MINUTES=60
SWAP_EXPIRY_MINUTES=10
READY_ALERT_MINUTES=30
HOSPITAL_TIMEZONE=Asia/Kolkata
DEFAULT_CONSULT_MINUTES=12
SCHEDULE_HORIZON_DAYS=7

# --- Hardware ---------------------------------------------------------------
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
DEVICE_HMAC_SECRET=dev-device-secret-change-me
HARDWARE_ENABLED=false
HARDWARE_AUTO_COMPLETE=false
AUTO_COMPLETE_DEBOUNCE_MINUTES=2
SENSOR_DEBOUNCE_SECONDS=5

# --- Notifications ----------------------------------------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SMS_PROVIDER=mock
